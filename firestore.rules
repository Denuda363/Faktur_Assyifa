rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Supplier Rules
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSupplier(incoming());
      allow update: if isSignedIn() && isValidSupplier(incoming());
      allow delete: if isSignedIn();
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200;
    }

    // Invoice Rules
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidInvoice(incoming());
      allow update: if isSignedIn() && isValidInvoice(incoming());
      allow delete: if isSignedIn();

      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidPayment(incoming());
        allow delete: if isSignedIn();
      }
    }

    function isValidInvoice(data) {
      return data.supplierId is string && 
             data.invoiceNumber is string && 
             data.totalAmount is number && 
             data.date is string && 
             data.dueDate is string;
    }

    function isValidPayment(data) {
      return data.invoiceId is string && 
             data.amount is number && 
             data.date is string;
    }

    // Settings Rules
    match /settings/config {
      allow read: if true; // Publicly readable for login/branding
      allow write: if isSignedIn();
    }

    // Notification Rules
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidNotification(incoming());
      allow delete: if isSignedIn();
    }

    function isValidNotification(data) {
      return data.message is string && 
             data.type is string && 
             data.read is bool && 
             data.createdAt is string;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
